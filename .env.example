# Smart Procurement Vendor AI Configuration

# Database Connection (PostgreSQL with direct psycopg2 queries)
# Leave as postgresql://... for Docker or production Postgres.
# If PostgreSQL is not running locally, the backend gracefully falls back to local SQLite for instant testing.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_procurement

# Anthropic Claude API Key
# If omitted or left as default, intelligent heuristic AI fallback is used for offline testing
ANTHROPIC_API_KEY=your_claude_api_key_here

# JWT Authentication Secret
JWT_SECRET=super-secret-procurement-jwt-key-2025

# Port
PORT=8000
